// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  name        String?
  email       String    @unique
  image       String?
  characterId Int?      @unique
  layouts     Layout[]
  hearts      Heart[]
  avatar      Avatar?
  role        Role      @default(USER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
}

// A local copy of the bytes behind User.image. Discord serves avatars from a
// content-addressed path, so the URL in User.image stops resolving as soon as
// the user changes their avatar. Holding the bytes ourselves means the image
// the site renders never expires, even when the upstream URL is long dead.
//
// Kept in its own table so avatar bytes never ride along on a `User` include.
model Avatar {
  userId      Int      @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null records a source we tried and could not download, which stops the
  // avatar route from re-fetching a dead URL on every request.
  data        Bytes?
  contentType String?
  source      String
  fetchedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Layout {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  title        String
  description  String?
  jobId        String
  isPvp        Boolean   @default(false)
  layout       Int
  encodedSlots String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @default(now())
  deletedAt    DateTime?
  published    Boolean   @default(true)
  xhb          Int?
  wxhb         Int?
  exhb         Int?
  hb           String?
  hearts       Heart[]
  locale       String?   @default("en")
  parentId     Int?
  parentLayout Layout?   @relation("ChildToParent", fields: [parentId], references: [id])
  childLayouts Layout[]  @relation("ChildToParent")
}

model Heart {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  layout    Layout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId  Int
  createdAt DateTime @default(now())
}

model Character {
  id               Int      @id @default(autoincrement())
  face             String
  portrait         String
  name             String
  title            String?
  titleTop         Boolean? @default(false)
  world            String
  race             String
  nameday          String
  guardian         String
  cityState        String
  grandCompanyName String?
  grandCompanyRank String?
  freeCompany      String?
  activeClassJob   Json?
  gearSlots        Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}
